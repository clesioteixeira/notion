{
  "name": "notion",
  "version": "1.0.0",
  "description": "Aplicativo Electron que abre o Notion com interface nativa",
  "homepage": "https://www.notion.so",
  "author": {
    "name": "Kureshio",
    "email": "dev@kureshio.xyz"
  },
  "license": "ISC",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron . --enable-features=UseOzonePlatform --ozone-platform=wayland --disable-vulkan",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
    "dependencies": {
    "electron-updater": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^24.9.1"
    
  },
  "build": {
    "appId": "com.notion.app",
    "productName": "Notion",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "offline.html",
      "preferences.html",
      "index.html",
      "assets/**/*"
    ],
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "publish": {
    "provider": "github",
    "owner": "kureshio",
    "repo": "notion-electron"
  }
}
